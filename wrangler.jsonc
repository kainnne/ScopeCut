{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scopecut-auth",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://scopecut.kainnne.com,https://kainnne.github.io,http://localhost:8788",
    "ALLOWED_EMAILS": "ryanzhu@kainnne.com",
    "AUTH_FROM": "ScopeCut <login@auth.kainnne.com>",
    "AUTH_REPLY_TO": "ryanzhu@kainnne.com",
    "OPENAI_MODEL": "gpt-5.6-terra",
    "OPENAI_REASONING_EFFORT": "medium",
    "PREDICTED_OUTPUT_TOKENS": "8000",
    "DAILY_BUDGET_MICROUSD": "3000000",
    "POINT_MICROUSD": "30000",
    "ANON_QUOTES_PER_HOUR": "12",
    "ANON_GENERATIONS_PER_HOUR": "10",
    "IP_QUOTES_PER_HOUR": "30",
    "IP_GENERATIONS_PER_HOUR": "20",
    "FILE_TTL_SECONDS": "86400"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scopecut-auth",
      "database_id": "2d9b892e-02cc-4e3a-a287-3f079a476774"
    }
  ]
}
