# ScopeCut 本機 Bridge
PORT=8788

# 登入帳密(建議與 WikiNB Bridge 同一組)
SCOPECUT_AUTH_USER=
SCOPECUT_AUTH_PASS=

# 驗證碼收件(可逗號分隔;可沿用 WIKINB_AUTH_EMAILS)
SCOPECUT_AUTH_EMAILS=chaos60649@gmail.com

# 寄件:沿用 WikiNB 的 Gmail 應用程式密碼
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 未設定 SMTP 時,驗證碼印在終端機
DEV_LOG_CODE=true

# GitHub Pages 靜態站可呼叫本機 Bridge
CORS_ORIGINS=http://localhost:8788,https://zx50416.github.io

# WikiNB 專案根目錄(規劃文件寫進 <WIKINB_ROOT>/wiki/Projects/)
WIKINB_ROOT=/Users/kaine/Desktop/Projects/WikiNB

# 產生文件後自動 git commit + push
SCOPECUT_GIT_PUSH=true

# Codex(留空則讀 ~/.codex/config.toml);永遠以 --sandbox read-only 執行
CODEX_MODEL=
CODEX_REASONING_EFFORT=
CODEX_TIMEOUT_MS=900000

# 測試用:1 = 不真的呼叫 codex
SCOPECUT_FAKE_CODEX=
