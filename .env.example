# ScopeCut 本機伺服器
PORT=8788

# 登入帳密(建議與 WikiNB Bridge 同一組)
SCOPECUT_AUTH_USER=
SCOPECUT_AUTH_PASS=

# WikiNB 專案根目錄(規劃文件會寫進 <WIKINB_ROOT>/wiki/Projects/)
WIKINB_ROOT=/Users/kaine/Desktop/Projects/WikiNB

# 產生文件後自動 git commit + push 到 WikiNB(用本機 git 憑證)
SCOPECUT_GIT_PUSH=true

# Codex 設定(留空則讀 ~/.codex/config.toml 的預設)
CODEX_MODEL=
CODEX_REASONING_EFFORT=
# Codex 最長執行時間(毫秒),預設 15 分鐘
CODEX_TIMEOUT_MS=900000

# 測試用:1 = 不真的呼叫 codex,回傳固定內容
SCOPECUT_FAKE_CODEX=
